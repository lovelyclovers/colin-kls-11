<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>All About Me</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;700&family=Fraunces:ital,wght@0,600;0,800;1,500&family=Nunito:wght@400;600;700&display=swap" rel="stylesheet">
<style>
  :root{
    --paper:#fbf3e4; --paper2:#f5e8cf; --ink:#4a3b32; --soft:#8a7566;
    --line:rgba(120,90,60,.13);
    --peach:#ffd9c2; --butter:#fff1a8; --mint:#cdecd3; --sky:#cfe4f5; --blush:#f9cfe0; --lav:#e1d6f5;
    --accent:#d9694a; --green:#6f9a72;
    --shadow:0 6px 14px rgba(90,60,30,.18);
  }
  body.night{
    --paper:#2b2220; --paper2:#352a27; --ink:#f4e6d2; --soft:#b9a38d; --line:rgba(255,220,170,.07);
    --peach:#5c3b32; --butter:#5d5230; --mint:#3a4f3f; --sky:#35495a; --blush:#5a3a49; --lav:#473e5e;
    --accent:#ffa57d; --green:#9cc79f; --shadow:0 6px 16px rgba(0,0,0,.45);
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{scroll-behavior:smooth}
  body{
    font-family:'Nunito',system-ui,sans-serif;color:var(--ink);line-height:1.7;
    background-color:var(--paper);
    background-image:
      linear-gradient(var(--line) 1px,transparent 1px),
      radial-gradient(circle at 20% 10%,rgba(255,200,150,.25),transparent 40%),
      radial-gradient(circle at 85% 80%,rgba(255,180,160,.18),transparent 45%);
    background-size:100% 32px,auto,auto;
    transition:background-color .6s,color .6s;overflow-x:hidden;
  }
  .hand{font-family:'Caveat',cursive;font-weight:700}
  .wrap{max-width:980px;margin:0 auto;padding:0 22px}

  /* little top bar */
  .top{display:flex;justify-content:space-between;align-items:center;padding:18px 22px;max-width:980px;margin:auto}
  .top .hand{font-size:1.6rem}
  .top nav{display:flex;gap:16px;align-items:center;flex-wrap:wrap;justify-content:flex-end}
  .top a{color:var(--ink);text-decoration:none;font-weight:600;font-size:.92rem;position:relative}
  .top a::after{content:"";position:absolute;left:0;right:0;bottom:-2px;height:3px;border-radius:3px;background:var(--accent);transform:scaleX(0);transition:.25s}
  .top a:hover::after{transform:scaleX(1)}
  #mode{border:2px dashed var(--soft);background:transparent;color:var(--ink);border-radius:30px;padding:4px 12px;cursor:pointer;font:inherit;font-weight:700;font-size:.85rem}
  #mode:hover{background:var(--butter)}
  @media(max-width:620px){.top nav a{display:none}}

  /* hero */
  .hero{display:grid;grid-template-columns:1fr 340px;gap:40px;align-items:center;padding:30px 0 50px}
  @media(max-width:800px){.hero{grid-template-columns:1fr;text-align:center}}
  .hello{font-size:2rem;color:var(--accent);transform:rotate(-3deg);display:inline-block}
  .hero h1{font-family:'Fraunces',serif;font-weight:800;font-size:clamp(2.6rem,7vw,4.4rem);line-height:1.05;margin:4px 0 12px}
  .scribble{background:linear-gradient(transparent 62%,var(--butter) 62%,var(--butter) 90%,transparent 90%);padding:0 6px}
  .hero p.lead{font-size:1.12rem;color:var(--soft);max-width:470px}
  @media(max-width:800px){.hero p.lead{margin:auto}}
  .typed-line{margin-top:14px;font-size:1.7rem}
  .typed-line b{color:var(--green);border-right:3px solid var(--accent);padding-right:3px;animation:caret .8s infinite}
  @keyframes caret{50%{border-color:transparent}}
  .hero-btns{display:flex;gap:12px;margin-top:22px;flex-wrap:wrap}
  @media(max-width:800px){.hero-btns{justify-content:center}}
  .btn{display:inline-block;padding:10px 22px;border-radius:14px;border:2.5px solid var(--ink);background:var(--peach);color:var(--ink);text-decoration:none;font-weight:700;box-shadow:4px 4px 0 var(--ink);transition:.15s;cursor:pointer;font-family:inherit;font-size:.95rem}
  .btn:hover{transform:translate(-2px,-2px);box-shadow:6px 6px 0 var(--ink)}
  .btn:active{transform:translate(3px,3px);box-shadow:1px 1px 0 var(--ink)}
  .btn.alt{background:var(--mint)}

  /* polaroid */
  .polaroid{position:relative;width:290px;max-width:80vw;margin:auto;background:#fffdf8;padding:14px 14px 56px;box-shadow:var(--shadow);transform:rotate(4deg);transition:transform .4s;cursor:pointer}
  .polaroid:hover{transform:rotate(-1deg) scale(1.03)}
  .polaroid .pic{aspect-ratio:1;background:linear-gradient(135deg,var(--peach),var(--blush));display:grid;place-items:center;overflow:hidden;font-family:'Fraunces',serif;font-size:5.5rem;font-weight:800;color:#fff;text-shadow:3px 3px 0 rgba(0,0,0,.12)}
  .polaroid .pic img{width:100%;height:100%;object-fit:cover}
  .polaroid .cap{position:absolute;bottom:12px;left:0;right:0;text-align:center;font-size:1.6rem;color:#5a4636}
  .tape{position:absolute;top:-16px;left:50%;width:110px;height:32px;transform:translateX(-50%) rotate(-4deg);background:rgba(255,226,140,.8);box-shadow:0 2px 4px rgba(0,0,0,.1);
    background-image:repeating-linear-gradient(90deg,transparent 0 6px,rgba(255,255,255,.35) 6px 8px)}
  .sticker{position:absolute;font-size:2.4rem;animation:wob 3.5s ease-in-out infinite;filter:drop-shadow(2px 3px 2px rgba(0,0,0,.2))}
  .s1{top:-26px;right:-22px}.s2{bottom:30px;left:-30px;animation-delay:-1.5s}
  @keyframes wob{50%{transform:rotate(14deg) translateY(-6px)}}
  .tiny{text-align:center;color:var(--soft);font-size:.8rem;margin-top:22px}

  /* sections */
  section{padding:34px 0}
  h2{font-family:'Fraunces',serif;font-size:2rem;margin-bottom:6px}
  h2 .hand{color:var(--accent);font-size:1.6rem;margin-left:6px;font-weight:500}
  .sub{color:var(--soft);margin-bottom:24px}
  .squiggle{height:14px;width:150px;margin:2px 0 14px;background:
    radial-gradient(circle at 7px 0,transparent 6px,var(--accent) 6.5px,var(--accent) 8.5px,transparent 9px) 0 0/14px 14px repeat-x;opacity:.7}

  /* sticky notes */
  .notes{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:26px 22px;padding:8px 4px}
  .note{padding:22px 18px 18px;box-shadow:var(--shadow);transition:transform .25s;position:relative;min-height:112px}
  .note::before{content:"";position:absolute;top:-9px;left:50%;width:14px;height:14px;border-radius:50%;background:var(--accent);box-shadow:inset -2px -2px 3px rgba(0,0,0,.3),0 2px 3px rgba(0,0,0,.25);transform:translateX(-50%)}
  .note:nth-child(6n+1){background:var(--butter);transform:rotate(-2deg)}
  .note:nth-child(6n+2){background:var(--peach);transform:rotate(1.5deg)}
  .note:nth-child(6n+3){background:var(--mint);transform:rotate(-1deg)}
  .note:nth-child(6n+4){background:var(--sky);transform:rotate(2deg)}
  .note:nth-child(6n+5){background:var(--blush);transform:rotate(-1.5deg)}
  .note:nth-child(6n+6){background:var(--lav);transform:rotate(1deg)}
  .note:hover{transform:rotate(0) scale(1.06) translateY(-4px);z-index:2}
  .note small{font-family:'Caveat',cursive;font-size:1.25rem;display:block;opacity:.75;line-height:1.1}
  .note b{font-size:1.05rem;display:block;margin-top:4px}
  .note .e{font-size:1.5rem}

  /* story */
  .story{background:#fffdf8;color:#4a3b32;padding:28px 30px;box-shadow:var(--shadow);transform:rotate(-.6deg);position:relative;border-left:6px solid var(--accent);font-size:1.08rem}
  body.night .story{background:#3a2e2a;color:var(--ink)}
  .story::first-letter{font-family:'Fraunces',serif;font-size:3rem;float:left;line-height:.9;margin:4px 8px 0 0;color:var(--accent)}
  .sig{font-size:1.8rem;text-align:right;color:var(--accent);margin-top:6px}

  /* numbers */
  .nums{display:flex;flex-wrap:wrap;gap:16px;margin-top:28px}
  .num{flex:1 1 130px;text-align:center;border:2.5px dashed var(--soft);border-radius:20px;padding:14px 8px}
  .num .n{font-family:'Fraunces',serif;font-size:2.2rem;font-weight:800;color:var(--accent);line-height:1.1}
  .num span{font-size:.85rem;color:var(--soft)}

  /* skills */
  .skills{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:12px 40px}
  .sk{display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:2px dotted var(--line)}
  .dots{display:flex;gap:5px}
  .dots i{width:16px;height:16px;border-radius:50%;border:2px solid var(--ink);background:transparent;transition:.3s}
  .dots i.on{background:var(--green);border-color:var(--green)}
  .sk:hover .dots i.on{transform:scale(1.25)}

  /* diary chapters */
  .chapters{position:relative;padding-left:34px;border-left:3px dashed var(--soft);margin-left:12px}
  .chap{position:relative;margin-bottom:26px;background:#fffdf8;color:#4a3b32;padding:16px 20px;box-shadow:var(--shadow);border-radius:4px 16px 16px 16px}
  body.night .chap{background:#3a2e2a;color:var(--ink)}
  .chap::before{content:attr(data-e);position:absolute;left:-58px;top:10px;width:40px;height:40px;border-radius:50%;background:var(--butter);border:3px solid var(--paper);display:grid;place-items:center;font-size:1.2rem}
  .chap .yr{font-size:1.4rem;color:var(--accent);line-height:1}
  .chap b{display:block}
  .chap p{color:var(--soft);font-size:.95rem}

  /* stickers */
  .stickers{display:flex;flex-wrap:wrap;gap:14px}
  .stk{background:#fffdf8;color:#4a3b32;padding:10px 20px;border-radius:40px;border:3px solid #fffdf8;outline:2.5px dashed var(--soft);box-shadow:var(--shadow);font-weight:700;cursor:default;transition:.25s}
  body.night .stk{background:#3a2e2a;color:var(--ink);border-color:#3a2e2a}
  .stk:nth-child(odd){transform:rotate(-3deg)}.stk:nth-child(even){transform:rotate(2.5deg)}
  .stk:hover{transform:rotate(0) scale(1.15) translateY(-4px);background:var(--butter)}

  /* favourites */
  .favs{display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:20px}
  .fav{background:var(--paper2);border-radius:20px;padding:18px 22px;border:2.5px solid var(--ink);box-shadow:4px 4px 0 var(--ink)}
  .fav h3{font-size:1.5rem;color:var(--accent)}
  .fav ul{list-style:none;margin-top:4px}
  .fav li::before{content:"♡ ";color:var(--accent)}

  /* jar */
  .jar{text-align:center;padding:10px}
  .jar-box{font-size:4.5rem;cursor:pointer;display:inline-block;transition:.2s}
  .jar-box:hover{animation:shake .5s}
  @keyframes shake{25%{transform:rotate(-10deg)}75%{transform:rotate(10deg)}}
  .paper{max-width:430px;margin:14px auto 0;min-height:90px;background:var(--butter);padding:20px;box-shadow:var(--shadow);transform:rotate(-1.5deg);font-size:1.7rem;line-height:1.25;display:grid;place-items:center;color:#4a3b32}
  body.night .paper{color:var(--ink)}
  .paper.pop{animation:pop .5s}
  @keyframes pop{0%{transform:scale(.3) rotate(-20deg);opacity:0}100%{transform:scale(1) rotate(-1.5deg);opacity:1}}

  /* say hi */
  .hi-card{background:var(--blush);border:2.5px solid var(--ink);box-shadow:6px 6px 0 var(--ink);border-radius:24px;padding:28px;display:grid;grid-template-columns:1fr 1fr;gap:20px;align-items:center}
  @media(max-width:700px){.hi-card{grid-template-columns:1fr}}
  .hi-card h2{margin-bottom:0}
  .hi-card ul{list-style:none}
  .hi-card li{padding:6px 0;font-weight:700}

  footer{text-align:center;padding:50px 20px 70px;color:var(--soft)}
  footer .hand{font-size:1.6rem}

  /* floating leaves */
  .leaf{position:fixed;top:-40px;font-size:1.4rem;opacity:.6;pointer-events:none;z-index:0;animation:fall linear infinite}
  @keyframes fall{to{transform:translate(60px,110vh) rotate(360deg)}}
  main,.top{position:relative;z-index:1}

  .reveal{opacity:0;transform:translateY(30px);transition:opacity .7s,transform .7s}
  .reveal.show{opacity:1;transform:none}
</style>
</head>
<body>

