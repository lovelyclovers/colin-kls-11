<script>
  // ===== EDIT THESE =====
  const ROLES = ["student","daydreamer","tea lover","night owl","work in progress"];
  const SKILLS = [["Talking to people",5],["Working in a team",4],["Staying organised",4],["Being creative",4],["English",3],["Cooking (instant noodles count)",2]];
  const NOTES = [
    "I can't start my day without coffee ☕",
    "I once stayed up all night to finish a book 📚",
    "I want to visit 20 countries one day ✈️",
    "Every expert was once a beginner 🌱",
    "I'm always hungry for snacks 🍟",
    "I talk to my plants (they listen) 🪴"
  ];
  // ======================

  // typing
  const typed = document.getElementById('typed'); let ri=0,ci=0,del=false;
  (function t(){
    const w = ROLES[ri]; typed.textContent = w.slice(0,ci);
    if(!del && ci===w.length){del=true;return setTimeout(t,1400)}
    if(del && ci===0){del=false;ri=(ri+1)%ROLES.length}
    ci += del?-1:1; setTimeout(t, del?50:100);
  })();

  // skills as dots
  document.getElementById('skillList').innerHTML = SKILLS.map(([n,l]) =>
    `<div class="sk"><span>${n}</span><span class="dots">${[1,2,3,4,5].map(i=>`<i data-on="${i<=l}"></i>`).join('')}</span></div>`).join('');

  // reveal + counters + dots filling
  const count = el => { const T=+el.dataset.c; let n=0, s=Math.max(1,Math.ceil(T/50));
    const id=setInterval(()=>{n=Math.min(T,n+s);el.textContent=n;if(n>=T)clearInterval(id)},30) };
  const io = new IntersectionObserver(es => es.forEach(e => {
    if(!e.isIntersecting) return;
    e.target.classList.add('show');
    e.target.querySelectorAll('[data-c]').forEach(count);
    e.target.querySelectorAll('.dots i[data-on="true"]').forEach((d,i)=>setTimeout(()=>d.classList.add('on'),150*(i%5)+200));
    io.unobserve(e.target);
  }), {threshold:.15});
  document.querySelectorAll('.reveal').forEach(el => io.observe(el));

  // evening mode
  const mode = document.getElementById('mode');
  mode.onclick = () => { document.body.classList.toggle('night');
    mode.textContent = document.body.classList.contains('night') ? '☀️ daytime mode' : '🌙 evening mode'; };

  // photo
  const file = document.getElementById('file');
  document.getElementById('polaroid').onclick = () => file.click();
  file.onchange = () => { const f=file.files[0]; if(!f) return; const r=new FileReader();
    r.onload = () => document.getElementById('pic').innerHTML = '<img alt="Me" src="'+r.result+'">'; r.readAsDataURL(f); };

  // jar
  let last=-1;
  document.getElementById('jar').onclick = () => {
    let n; do{n=Math.floor(Math.random()*NOTES.length)}while(n===last); last=n;
    const p=document.getElementById('paper'); p.textContent=NOTES[n];
    p.classList.remove('pop'); void p.offsetWidth; p.classList.add('pop');
  };

  // falling leaves & petals
  const bits = ['🍃','🌸','🍂','✨','🌼'];
  for(let i=0;i<9;i++){
    const l=document.createElement('div'); l.className='leaf'; l.textContent=bits[i%bits.length];
    l.style.left=(Math.random()*100)+'vw'; l.style.animationDuration=(14+Math.random()*14)+'s';
    l.style.animationDelay=(-Math.random()*20)+'s'; l.style.fontSize=(1+Math.random()*.8)+'rem';
    document.body.appendChild(l);
  }

  // initials
  const parts = document.getElementById('name').textContent.trim().split(/\s+/);
  document.getElementById('pic').textContent = (parts[0][0]+(parts[1]?parts[1][0]:'')).toUpperCase();
  document.getElementById('yr').textContent = new Date().getFullYear();
</script>
</body>
</html>